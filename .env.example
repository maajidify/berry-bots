# Copy to .env (never commit .env). Everything is optional: with no .env the game runs fully
# offline with heuristic brains and a mocked chain.

# ---------- Bot brains (NEAR AI Cloud, OpenAI-compatible) ----------
# Get a key at https://cloud.near.ai (or claim $10 of credits at https://nearbuilders.org/dashboard)
NEAR_AI_API_KEY=
# LLM_BASE_URL=https://cloud-api.near.ai/v1
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_TIMEOUT_MS=15000
# Only some bots on the LLM (cheaper): comma-separated bot ids
# LLM_BOTS=pixela,grief,envoy,blade
# BRAIN_MODE=auto            # auto | heuristic | llm

# ---------- Game ----------
# SEED=7
# ROUNDS=120
# ROUND_MS=2500              # default 6000 when LLM brains are on
# PORT=8787

# ---------- Chain ----------
CHAIN_MODE=local             # local (mocked, offline) | testnet
# SETTLE_EVERY=5             # rounds folded into one settle_round

# Testnet mode only (see README "Testnet mode"):
# NEAR_OPERATOR_ID=yourname.testnet
# NEAR_OPERATOR_KEY=ed25519:...           # your testnet account's private key
# BERRY_CONTRACT_ID=berry.yourname.testnet
# BOT_PARENT_ACCOUNT=yourname.testnet     # bots become goldie.yourname.testnet, ...
# NEAR_RPC_URL=https://test.rpc.fastnear.com
